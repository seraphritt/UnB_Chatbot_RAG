    </node>
    <node id="&quot;CALCIUM&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"An essential mineral for bone health, whose intake is crucial during menopause to prevent further bone loss."</data>
      <data key="d2">chunk-2738ce638e124fd6721d732e5c5b3dc4</data>
    </node>
    <node id="&quot;SBH&quot;">
