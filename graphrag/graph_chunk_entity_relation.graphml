      <data key="d2">chunk-0071e16106ef52a6036e41e0d54d77b3</data>
    </node>
    <node id="&quot;SISTEMA FAMILIAR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"O Sistema Familiar é compreendido como um sistema baseado nas relações, com distribuição do poder de cada membro, estabelecimento de papéis e desenvolvimento de códigos."</data>
      <data key="d2">chunk-288f6abb61666f94c6198793c72cba7e</data>
    </node>
