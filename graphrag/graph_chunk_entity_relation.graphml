    </node>
    <node id="&quot;ALEITAMENTO MATERNO &quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Aleitamento Materno refers to breastfeeding."&lt;SEP&gt;"Aleitamento materno refers to breastfeeding, the natural process of feeding infants with milk from their mothers."</data>
      <data key="d2">chunk-1177947940cfb01dee281aa1fc5d9ca2&lt;SEP&gt;chunk-c5519e896279abca76223bfca3fed683</data>
