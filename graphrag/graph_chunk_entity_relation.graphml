      <data key="d1">"Rehabilitation aims to restore functional independence and reduce the effects of the incapacitating process."</data>
      <data key="d2">chunk-0071e16106ef52a6036e41e0d54d77b3</data>
    </node>
    <node id="&quot;ACIDENTE VASCULAR ENCEFÁLICO (AVE)&quot;">
