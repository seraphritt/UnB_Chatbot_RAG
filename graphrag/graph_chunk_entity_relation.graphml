    <node id="&quot;OPINIÃO DE ESPECIALISTAS DESPROVIDA DE AVALIAÇÃO CRÍTICA OU BASEADA EM MATÉRIAS BÁSICAS (ESTUDO FISIOLÓGICO OU ESTUDO COM ANIMAIS)">
