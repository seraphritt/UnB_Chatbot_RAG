      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;CONCEDENTE&quot;">
      <data key="d2">chunk-5a080acc0efc63e3b6d8a356d163a71d</data>
      <data key="d1">"UnB manages the registration of companies (concedentes) as potential internship providers through its system."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
