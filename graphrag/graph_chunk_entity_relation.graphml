      <data key="d1">"A resolution from the CONSELHO FEDERAL DE MEDICINA regarding obesity treatment standards."</data>
      <data key="d2">chunk-350ef385fb34bb6c3efa65e9f151927d</data>
    </node>
    <node id="&quot;OBESIDADE MÓRBIDA&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Severe obesity, a medical condition addressed in regulations and clinical practice."</data>
      <data key="d2">chunk-350ef385fb34bb6c3efa65e9f151927d</data>
    </node>
    <node id="&quot;DISTÚRBIOS ALIMENTARES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Eating disorders, a complex issue encompassing various psychological and behavioral conditions."</data>
      <data key="d2">chunk-350ef385fb34bb6c3efa65e9f151927d</data>
    </node>
    <node id="&quot;BULIMIA&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"A specific type of eating disorder characterized by recurrent episodes of binge eating followed by purging behaviors."</data>
      <data key="d2">chunk-350ef385fb34bb6c3efa65e9f151927d</data>
    </node>
    <node id="&quot;COMPULSÃO ALIMENTAR&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"A psychological condition characterized by recurrent episodes of consuming large amounts of food in a short period of time, often accompanied by feelings of guilt and shame."&lt;SEP&gt;"Binge-eating disorder, a condition involving uncontrollable episodes of consuming large amounts of food."</data>
      <data key="d2">chunk-9c66e12640babdcc62f4a059f486ea1e&lt;SEP&gt;chunk-350ef385fb34bb6c3efa65e9f151927d</data>
    </node>
    <node id="&quot;ANOREXIA NERVOSA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A serious eating disorder characterized by severe food restriction, intense fear of weight gain, and distorted body image."&lt;SEP&gt;"A serious eating disorder characterized by severe restriction of food intake, leading to significant weight loss and distorted body image."&lt;SEP&gt;"Anorexia Nervosa is a serious eating disorder characterized by severe food restriction and an intense fear of gaining weight."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64&lt;SEP&gt;chunk-7e876137e542843573f14c1bb8c52122&lt;SEP&gt;chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;BULIMIA NERVOSA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An eating disorder characterized by recurrent episodes of binge eating followed by purging behaviors such as vomiting or misuse of laxatives."&lt;SEP&gt;"An eating disorder involving recurrent episodes of binge eating followed by purging behaviors like vomiting or laxative use."&lt;SEP&gt;"Bulimia Nervosa is an eating disorder involving recurrent episodes of binge eating followed by purging behaviors such as vomiting or using laxatives."&lt;SEP&gt;"Bulimia nervosa is a serious eating disorder characterized by recurrent episodes of binge eating followed by purging behaviors."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64&lt;SEP&gt;chunk-d735bb6849bc088a1f19d4352da76bf0&lt;SEP&gt;chunk-7e876137e542843573f14c1bb8c52122&lt;SEP&gt;chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;TRANSTORNO DO COMER COMPULSIVO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A disorder characterized by recurring episodes of consuming large amounts of food in a short period, accompanied by feelings of lack of control."</data>
      <data key="d2">chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;CÓRDAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"An author and researcher specializing in eating disorders, cited for epidemiological data on the prevalence of these conditions in Brazil."</data>
      <data key="d2">chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;LEITE; PEREIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A pair of researchers who published a work on anorexia nervosa, discussing its psychological aspects and diagnostic criteria."</data>
      <data key="d2">chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;BRUCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A psychiatrist who described the "phobia of weight" and "morbid fear of gaining weight" as key components of anorexia nervosa."</data>
      <data key="d2">chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;SLADE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A researcher who explored the visual, cognitive, affective, and behavioral aspects of body image judgment in individuals with eating disorders."</data>
      <data key="d2">chunk-56b717d5c3fa4fdb1d7a513fef54947f</data>
    </node>
    <node id="&quot;AMENORRHEA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The absence of at least three consecutive menstrual cycles in women, often associated with anorexia nervosa."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64</data>
    </node>
    <node id="&quot;HYPOTHALAMUS-PITUITARY-GONADAL (HPG) AXIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A complex system of hormonal regulation involving the hypothalamus, pituitary gland, and gonads that can be disrupted in eating disorders."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64</data>
    </node>
    <node id="&quot;OSTEOPOROSIS&quot;">
      <data key="d0">"CONDITION"</data>
      <data key="d1">"A condition characterized by weak and brittle bones, which can be induced by prolonged malnutrition seen in anorexia nervosa."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64</data>
    </node>
    <node id="&quot;INFERTILITY&quot;">
      <data key="d0">"CONDITION"</data>
      <data key="d1">"Difficulty conceiving a child, potentially caused by hormonal imbalances related to eating disorders."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64</data>
    </node>
    <node id="&quot;HYPOTENSION&quot;">
      <data key="d0">"CONDITION"</data>
      <data key="d1">"Low blood pressure, a common symptom of malnutrition associated with anorexia nervosa."</data>
      <data key="d2">chunk-503bb79036fc21416d88fae95eb47b64</data>
    </node>
    <node id="&quot;DSM–IV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The DSM-IV is a diagnostic and statistical manual of mental disorders used in psychiatry."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;CID–10&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The CID-10 is the International Statistical Classification of Diseases and Related Health Problems."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;BINGE EATING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Binge eating refers to consuming an unusually large amount of food in a short period, often accompanied by a sense of loss of control."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;VOMITTING&quot;">
      <data key="d0">"BEHAVIOR"</data>
      <data key="d1">"Vomitting is a purging behavior used to compensate for binge eating and prevent weight gain."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;LAXATIVES&quot;">
      <data key="d0">"SUBSTANCE"</data>
      <data key="d1">"Laxatives are drugs that stimulate bowel movements and are misused as a purging method."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;DIURETICS&quot;">
      <data key="d0">"SUBSTANCE"</data>
      <data key="d1">"Diuretics are medications that increase urine production, used to reduce fluid retention but also misused for purging."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;EXERCISE&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Excessive exercise is a compensatory behavior sometimes used to try and offset the calories consumed during binge eating."&lt;SEP&gt;"The text emphasizes the importance of physical activity and exercise for individuals with DM."</data>
      <data key="d2">chunk-519195a90f75760f68b6de2970b8be42&lt;SEP&gt;chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;RESTRICTED DIET&quot;">
      <data key="d0">"BEHAVIOR"</data>
      <data key="d1">"A restricted diet involves severely limiting food intake, often used as a coping mechanism in bulimia nervosa."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;FASTING&quot;">
      <data key="d0">"BEHAVIOR"</data>
      <data key="d1">"Fasting is abstaining from food for a prolonged period, another compensatory behavior seen in bulimia nervosa."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;CALORIE CONSUMPTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Calorie consumption refers to the intake of energy from food and beverages, a key factor in bulimia nervosa."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;BODY IMAGE DISTURBANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"People with bulimia often have a distorted body image, feeling excessively preoccupied with weight and shape."</data>
      <data key="d2">chunk-d735bb6849bc088a1f19d4352da76bf0</data>
    </node>
    <node id="&quot;AB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AB is a healthcare organization providing diabetes management services."&lt;SEP&gt;"AB is a healthcare system that plays an important role in identifying cases of eating disorders."&lt;SEP&gt;"AB likely refers to the Atenção Básica, which is Brazil's primary healthcare system."</data>
      <data key="d2">chunk-89e8d9694bc56b2df9df5ab0a1d78d0f&lt;SEP&gt;chunk-006463a549a2400203df1af73897ce16&lt;SEP&gt;chunk-7e876137e542843573f14c1bb8c52122</data>
