    <node id="&quot;PASSO 9–BEBA PELO MENOS DOIS LITROS (SEIS A OITO COPOS) DE ÁGUA POR DIA. DÊ PREFERÊNCIA AO CONSUMO DE ÁGUA NOS INTERVALOS DAS REFEIÇÕES.&quot;">
      <data key="d0">"EVENT"</data>
