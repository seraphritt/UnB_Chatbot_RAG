    </node>
    <node id="&quot;DESLIGAMENTO COMPULSORIAMENTE (O QUE ACONTECE QUANDO SE ESGOTA O TEMPO MÁXIMO DE PERMANÊNCIA NO CURSO E ESTE AINDA NÃO FOI CONCLUÍDO, OU QUANDO NÃO SÃO CUMPRIDOS REQUISITOS MÍNIMOS DE DESEMPENHO ACADÊMICO)&quot;">
