      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Glycated hemoglobin (HbA1C) provides an average measure of blood sugar control over the past 2-3 months."&lt;SEP&gt;"Glycated hemoglobin, reflecting average blood glucose levels over the past two to three months."</data>
      <data key="d2">chunk-f8fbdcca6142a11665b95bb70d17aa20&lt;SEP&gt;chunk-3efcb0f7cafd7155d35721d743353421</data>
