      <data key="d2">chunk-24ed024080994acf4b7f84fdfdadf700</data>
    </node>
    <node id="&quot;TURMAS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Turmas are classes or groups that students can enroll in."</data>
      <data key="d2">chunk-24ed024080994acf4b7f84fdfdadf700</data>
    </node>
    <node id="&quot;COMPONENTES CURRICULARES&quot;">
      <data key="d0">"EVENT"</data>
