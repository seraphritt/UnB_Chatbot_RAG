      <data key="d3">14.0</data>
      <data key="d4">"The PPC is developed by the University to ensure consistency in educational standards across courses."</data>
      <data key="d5">"curriculum management"</data>
      <data key="d6">chunk-a6bd9c133e851de0c23f808943eeda2d</data>
