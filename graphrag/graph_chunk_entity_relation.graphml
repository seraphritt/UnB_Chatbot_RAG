    </node>
    <node id="&quot;FUNCIONALIDADE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Functional independence refers to the ability to perform daily activities without assistance."</data>
      <data key="d2">chunk-0071e16106ef52a6036e41e0d54d77b3</data>
    </node>
    <node id="&quot;AUTONOMIA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Autonomy refers to self-governance and decision-making abilities."</data>
