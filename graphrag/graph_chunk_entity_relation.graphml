      <data key="d3">6.0</data>
      <data key="d4">"Thromboembolic lesions contribute to vascular dementia, characterized by various vascular mechanisms and cerebral changes."</data>
      <data key="d5">"vascular mechanisms, cognitive impairment"</data>
      <data key="d6">chunk-7c237c89e3d3730f160a6a8a3cf67ac7</data>
    </edge>
