      <data key="d2">chunk-5219cf0817cbb82473514dd9f7028dc0</data>
    </node>
    <node id="&quot;DECANATO DE PÓS-GRADUAÇÃO (DPG)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Decanato de Pós-Graduação (DPG) is a department of the University of Brasilia, providing information about scientific initiatives and scholarships."&lt;SEP&gt;"The postgraduate school dean's office at the University of Brasília (UnB)."</data>
      <data key="d2">chunk-ab673f3f31e4b6cfe2fab27d4c223fbb&lt;SEP&gt;chunk-69065f8900adcc5c23cde0bc047686d0</data>
