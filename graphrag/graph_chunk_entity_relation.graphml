      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quadro 1 emphasizes the importance of effective communication with older adults to improve their understanding and trust in healthcare providers."</data>
      <data key="d2">chunk-fc88ee6dfa63a03b874da042bb4efdf9</data>
    </node>
