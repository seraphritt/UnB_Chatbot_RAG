      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The employer that hires the intern."</data>
      <data key="d2">chunk-5219cf0817cbb82473514dd9f7028dc0</data>
    </node>
    <node id="&quot;TCE&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Technical Chart (TCE) detailing the tasks and responsibilities of the internship."&lt;SEP&gt;"The Term of Compromisso de Estágio (TCE), a legal document that outlines the terms and conditions of the internship."</data>
      <data key="d2">chunk-5a080acc0efc63e3b6d8a356d163a71d&lt;SEP&gt;chunk-5219cf0817cbb82473514dd9f7028dc0</data>
    </node>
    <node id="&quot;PLANO DE ATIVIDADES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Plan of Activities detailing the specific tasks to be performed during the internship."&lt;SEP&gt;"Plano de Atividades refers to the plan of activities for an internship."&lt;SEP&gt;"The Plan of Activities, outlining the tasks and objectives for the student's internship."</data>
      <data key="d2">chunk-1a5dd6915ab901bad633c800a1755091&lt;SEP&gt;chunk-5a080acc0efc63e3b6d8a356d163a71d&lt;SEP&gt;chunk-5219cf0817cbb82473514dd9f7028dc0</data>
    </node>
    <node id="&quot;SUPERVISOR PROFISSIONAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A professional supervisor assigned to the intern."</data>
      <data key="d2">chunk-5219cf0817cbb82473514dd9f7028dc0</data>
    </node>
    <node id="&quot;INFORMAÇÕES IMPORTANTES SOBRE ESTÁGIO&quot;">
