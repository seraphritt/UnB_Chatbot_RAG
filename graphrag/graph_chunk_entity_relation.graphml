      <data key="d0">"PERSON"</data>
      <data key="d1">A person suggests that it is possible to use previously completed courses outside of the UnB.</data>
      <data key="d2">chunk-8737c0a41a63b20de6e94c4437660b84</data>
    </node>
    <node id="&quot;VOCÊ DEVERÁ SOLICITAR O APROVEITAMENTO DE ESTUDOS&quot;">
      <data key="d0">"PERSON"</data>
