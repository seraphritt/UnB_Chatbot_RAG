      <data key="d2">chunk-8c59ac10b277f004755ca3a5a2e708dc</data>
    </node>
    <node id="&quot;ESTÁGIO&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"An internship or practicum is an activity where students gain practical experience in their field of study."&lt;SEP&gt;"The Estágio is the internship experience for students at the Universidade de Brasília (UnB)."</data>
      <data key="d2">chunk-ac407f61310418797bb84a4df139e830&lt;SEP&gt;chunk-8c59ac10b277f004755ca3a5a2e708dc</data>
    </node>
