      <data key="d0">"PERSON"</data>
      <data key="d1">"Linda Fried é uma Dra. que trabalhou na proposição de critérios objetivos mensuráveis para definir Fragilidade em idosos."</data>
      <data key="d2">chunk-321c37b4797b5287d1670044266e5d14</data>
    </node>
