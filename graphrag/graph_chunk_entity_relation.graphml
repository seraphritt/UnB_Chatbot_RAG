      <data key="d2">chunk-ab673f3f31e4b6cfe2fab27d4c223fbb</data>
    </node>
    <node id="&quot;INTERCÂMBIO E MOBILIDADE ACADÊMICA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interchange and academic mobility refers to the possibility of studying at other universities, either in Brazil or abroad, to enrich students' experiences."</data>
